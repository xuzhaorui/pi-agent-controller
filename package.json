{
  "name": "pi-agent-controller",
  "version": "0.1.0",
  "description": "Deterministic orchestration loop for advancing GitHub tasks with Pi agents",
  "type": "module",
  "keywords": ["pi-package", "pi", "agent", "orchestration", "github"],
  "license": "MIT",
  "engines": {
